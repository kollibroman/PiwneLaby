rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null && (
        // Owner can edit
        resource.data.ownerId == request.auth.uid
        // Buy now
        || (
          resource.data.isSold == false
          && request.resource.data.isSold == true
          && request.resource.data.soldTo == request.auth.uid
          && resource.data.ownerId != request.auth.uid
        )
        // Bidding
        || (
          resource.data.isSold == false
          && request.resource.data.highestBid > (resource.data.highestBid == null ? resource.data.price : resource.data.highestBid)
          && request.resource.data.highestBidderId == request.auth.uid
        )
      );

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
